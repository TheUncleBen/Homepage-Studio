# Environment variables for portainer-swarm.yml (and portainer-compose.yml).
#
# How to use: copy this file, change the lines marked REQUIRED, then load it in
# Portainer's stack editor (Environment variables > Load variables from .env
# file, or Advanced mode and paste). Full walkthrough: docs/DEPLOY.md, step 6.
#
# No secrets go in here. The encryption key, the single sign-on client secret
# and the mail password are Docker secrets (docs/DEPLOY.md, step 5).
# Values are example placeholders; nothing below is a real host or account.
#
# A line starting with # is not set. An Optional line shows the value used when
# it isn't set; remove the "# " to change it.

# --- Image -------------------------------------------------------------------
# Engineering templates use the exact qualified single application image.
STUDIO_IMAGE=ghcr.io/theuncleben/homepage-studio@sha256:<qualified-application-digest>

# --- Address and placement ---------------------------------------------------
# REQUIRED. The address people type in the browser: https://, the hostname your
# reverse proxy serves, no path. Must be https:// while sign-in is on.
STUDIO_PUBLIC_ORIGIN=https://homepage.example.test
# REQUIRED (Swarm only). The exact hostname (docker node ls) of the node that
# keeps Studio's data.
STUDIO_NODE=swarm-node-1

# --- Reverse proxy network ---------------------------------------------------
# Optional. The network Studio shares with your reverse proxy, spelled exactly
# as docker network ls shows it. Create it before you deploy (step 2).
# STUDIO_NETWORK_NAME=homepage-studio
# Recommended. The subnet of that network (step 2 shows how to read it), so the
# activity log and sign-in throttling see each visitor's real address instead
# of the proxy's. Comma-separated IP addresses or CIDR ranges.
# STUDIO_TRUSTED_PROXIES=10.0.10.0/24

# --- Storage -----------------------------------------------------------------
# Optional. Where dashboards (config) and history, accounts and sessions (state)
# live. Default: the named volumes config and state on STUDIO_NODE. Set both to
# absolute host paths to bind mount instead; create the directories first and
# chown them to 1000:1000 (step 3). Only one Studio may use them at a time.
# STUDIO_CONFIG_PATH=/srv/homepage-studio/config
# STUDIO_STATE_PATH=/srv/homepage-studio/state
# REQUIRED for Docker Compose only (ignored by the Swarm stack). The absolute
# folder holding the four secret files (docs/DEPLOY-COMPOSE.md).
# STUDIO_SECRETS_DIR=/srv/homepage-studio/secrets

# --- Single sign-on with an identity provider (optional) ---------------------
# Leave these unset to use Studio's built-in accounts only. To sign in through
# an OpenID Connect identity provider, set the issuer and client ID and put the
# client secret in the studio_oidc_client_secret Docker secret. Setup guides:
# docs/IDP-OTHERS.md (any provider) and docs/IDP-AUTHENTIK.md (worked example).
# STUDIO_OIDC_ISSUER=https://idp.example.test/application/o/homepage-studio/
# STUDIO_OIDC_CLIENT_ID=<client ID from your identity provider>
# Optional. The provider's name on the sign-in button and account pages, for
# example Authentik. Default: Single sign-on.
# STUDIO_OIDC_NAME=Authentik
# Optional. Scopes requested. Keep offline_access so groups are checked again
# while people stay signed in.
# STUDIO_OIDC_SCOPES=openid profile email offline_access
# Optional. The claim in the provider's token that lists the person's groups.
# STUDIO_OIDC_GROUPS_CLAIM=groups
# Optional. Minutes between group checks for signed-in provider accounts,
# 1 to 1440.
# STUDIO_OIDC_REFRESH_MINUTES=15
# Optional. Identity provider groups whose members are Studio administrators,
# and the groups whose members may sign in, comma-separated and spelled exactly
# as the provider sends them. Set here, they can't be changed in Studio; leave
# them unset to choose them in Studio's Sign-in settings instead.
# STUDIO_OIDC_ADMIN_GROUPS=Homepage Studio Admins
# STUDIO_OIDC_ALLOWED_GROUPS=Homepage Studio Users
# Testing only: true accepts a plain http:// issuer. Leave unset in use,
# because tokens and the client secret would cross the network unencrypted.
# STUDIO_OIDC_ALLOW_HTTP=

# --- Email (optional: invitations, password resets, security alerts) ---------
# Setting the host turns email on. The password goes in the
# studio_smtp_password Docker secret.
# STUDIO_SMTP_HOST=smtp.example.test
# Optional. 465 uses TLS from the start; other ports must offer STARTTLS.
# STUDIO_SMTP_PORT=587
# Optional. true for TLS from the start, false for STARTTLS. Default: true only
# on port 465.
# STUDIO_SMTP_SECURE=
# STUDIO_SMTP_USER=studio@example.test
# Required when STUDIO_SMTP_HOST is set: the sender address. Use one your mail
# provider has verified for this account; most providers refuse others, and
# Administration > Activity then shows the provider's answer.
# STUDIO_SMTP_FROM_ADDRESS=studio@example.test
# Optional. The name people see as the sender. Default: Homepage Studio.
# STUDIO_SMTP_FROM_NAME=Homepage Studio
# Older single setting, still accepted instead of the two above (not both):
# an address, or "Name <address>".
# STUDIO_SMTP_FROM=

# --- Sign-in -----------------------------------------------------------------
# Optional. Studio's own sign-in is on by default. Set off only if your reverse
# proxy already decides who can reach Studio (docs/AUTHENTICATION.md).
# STUDIO_AUTH=on
# Recommended. The first administrator's username, created once on the first
# start with the password in the studio_admin_password Docker secret. Ignored as
# soon as Studio has any account, so later changes here change nothing. Leave
# it unset (and the secret off) to create the administrator in the browser.
# STUDIO_ADMIN_USERNAME=admin
# Optional. That administrator's email, for resets and security alerts. It
# follows the identity provider's email once you link the two accounts.
# STUDIO_ADMIN_EMAIL=you@example.test

# --- Framing -----------------------------------------------------------------
# Optional: origins allowed to embed the dashboard in a frame, separated by
# spaces (not commas). Unset or empty keeps the default 'self'. A value replaces
# the default, so include 'self' to keep same-origin framing. Example:
# STUDIO_FRAME_ANCESTORS="'self' https://ha.example.test:8123"

# --- Limits (defaults shown) -------------------------------------------------
# Snapshots kept per dashboard.
STUDIO_BACKUP_RETENTION=25
# Dashboards that can have a running worker at once, 1 to 64.
STUDIO_RENDERER_MAX_WORKERS=8
# Seconds before an idle dashboard's worker stops.
STUDIO_RENDERER_IDLE_SECONDS=600
# Seconds a worker may take to start, up to 120.
STUDIO_RENDERER_STARTUP_SECONDS=30

# --- Your own integration secrets --------------------------------------------
# API keys for widgets go in Docker secrets too, read with HOMEPAGE_FILE_*
# variables. Those names are yours, so they aren't in the templates; add them
# to the stack yourself (docs/DEPLOY.md, "Widget API keys as Docker secrets").
