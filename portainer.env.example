# DEVELOPMENT TEMPLATE. No official image has been published by this change.
# Approved release assets will contain exact image digests; do not substitute
# gethomepage/homepage here because Studio requires its native overlay.
STUDIO_IMAGE=ghcr.io/theuncleben/homepage-studio@sha256:<approved-writer-digest>
HOMEPAGE_IMAGE=ghcr.io/theuncleben/homepage-studio-renderer@sha256:<approved-renderer-digest>

# The address entered in the browser, including a nondefault port if used.
STUDIO_PUBLIC_ORIGIN=http://homepage.example.test:3000
STUDIO_PORT=3000

# Swarm only: select the one node holding both named volumes.
STUDIO_NODE=<docker-node-hostname>

# Optional; the default is 25 retained configuration snapshots.
STUDIO_BACKUP_RETENTION=25
