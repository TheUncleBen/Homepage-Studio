# Every setting the deployment templates pass to Studio. Lines starting with #
# are optional; uncomment and fill in the ones you need. An empty or unset
# optional setting uses the default shown. Details: docs/DEPLOY.md (Values) and
# docs/AUTHENTICATION.md (Settings reference).

# --- Image -------------------------------------------------------------------
# Engineering templates use the exact qualified single application image.
STUDIO_IMAGE=ghcr.io/theuncleben/homepage-studio@sha256:<qualified-application-digest>

# --- Required ----------------------------------------------------------------
# The address entered in the browser, including a nondefault port if used.
# Must be https:// while sign-in is on.
STUDIO_PUBLIC_ORIGIN=https://homepage.example.test
# Swarm only: the exact hostname (docker node ls) of the node that runs Studio.
STUDIO_NODE=<docker-node-hostname>

# --- Port and storage --------------------------------------------------------
# Port published on the host. Unused if your reverse proxy reaches Studio over
# a Docker network and you remove the ports entry (docs/REVERSE-PROXY.md).
STUDIO_PORT=3000
# Where dashboards (config) and history, accounts and sessions (state) live.
# Default: the named volumes config and state. Set an absolute host path to use
# a bind mount instead. Create the directory first and make it owned by
# UID/GID 1000 (chown 1000:1000). Only one Studio may use a directory at a time.
# STUDIO_CONFIG_PATH=/srv/homepage-studio/config
# STUDIO_STATE_PATH=/srv/homepage-studio/state

# --- Limits (defaults shown) -------------------------------------------------
# Snapshots kept per dashboard.
STUDIO_BACKUP_RETENTION=25
# Dashboards that can have a running worker at once, 1 to 64.
STUDIO_RENDERER_MAX_WORKERS=8
# Seconds before an idle dashboard's worker stops.
STUDIO_RENDERER_IDLE_SECONDS=600
# Seconds a worker may take to start, up to 120.
STUDIO_RENDERER_STARTUP_SECONDS=30

# --- Framing -----------------------------------------------------------------
# Optional: origins allowed to embed the dashboard in a frame, separated by
# spaces (not commas). Unset or empty keeps the default 'self'. A value replaces
# the default, so include 'self' to keep same-origin framing. Example:
# STUDIO_FRAME_ANCESTORS="'self' https://ha.example.test:8123"

# --- Sign-in (docs/AUTHENTICATION.md) ----------------------------------------
# On by default and needs an https:// origin. Set off only if your reverse
# proxy already controls who can reach Studio.
# STUDIO_AUTH=on
# Long random text that encrypts authenticator secrets and single sign-on
# tokens. Recommended; keep it, because changing it resets authenticator apps.
# Or STUDIO_AUTH_KEY_FILE=/run/secrets/<name> to read it from a mounted secret.
# STUDIO_AUTH_KEY=<long random text>
# STUDIO_AUTH_KEY_FILE=
# Comma-separated IP addresses or CIDR ranges of your reverse proxies, so the
# activity log and sign-in throttling see the real client address.
# STUDIO_TRUSTED_PROXIES=<reverse proxy IP or CIDR>

# --- Single sign-on (OIDC, for example Authentik) ----------------------------
# Issuer, client ID and client secret go together.
# STUDIO_OIDC_ISSUER=https://authentik.example.test/application/o/<slug>/
# STUDIO_OIDC_CLIENT_ID=<client ID>
# STUDIO_OIDC_CLIENT_SECRET=<client secret>
# STUDIO_OIDC_CLIENT_SECRET_FILE=
# Name on the sign-in button. Default: Authentik.
# STUDIO_OIDC_NAME=Authentik
# Scopes requested. Keep offline_access so groups are rechecked while people
# stay signed in. Default: openid profile email offline_access
# STUDIO_OIDC_SCOPES=openid profile email offline_access
# Claim in the provider's token that lists the person's groups. Default: groups
# STUDIO_OIDC_GROUPS_CLAIM=groups
# Minutes between group rechecks for signed-in provider accounts, 1 to 1440.
# STUDIO_OIDC_REFRESH_MINUTES=15
# Testing only: set true to accept a plain http:// issuer. Leave unset in use,
# because tokens and the client secret would cross the network unencrypted.
# STUDIO_OIDC_ALLOW_HTTP=

# --- Email (optional: invitations, password resets, security alerts) ---------
# STUDIO_SMTP_HOST=smtp.example.test
# Default 587. Port 465 uses TLS from the start; other ports must offer STARTTLS.
# STUDIO_SMTP_PORT=587
# true for TLS from the start, false for STARTTLS. Default: true only on 465.
# STUDIO_SMTP_SECURE=
# STUDIO_SMTP_USER=studio@example.test
# STUDIO_SMTP_PASSWORD=<password>
# STUDIO_SMTP_PASSWORD_FILE=
# Sender address, required when STUDIO_SMTP_HOST is set.
# STUDIO_SMTP_FROM="Homepage Studio <studio@example.test>"

# --- Your own integration secrets ---------------------------------------------
# HOMEPAGE_VAR_* and HOMEPAGE_FILE_* variables are yours to name, so they are
# not in the templates. Add them to the service's environment yourself
# (docs/DEPLOY.md step 5).
